    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoLensWin.Core\PhotoLensWin.Core.csproj" />
  </ItemGroup>
</Project>
