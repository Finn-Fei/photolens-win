<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoLensWin.App.Views;assembly=PhotoLensWin.App"
        x:Class="PhotoLensWin.App.Views.MainWindow"
        Title="PhotoLens"
        Width="1280" Height="800" MinWidth="760" MinHeight="540"
        Background="#0E0F10">

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A2D31" />
    </Style>
    <Style Selector="Button.toggleOn">
      <Setter Property="Background" Value="#2E5C99" />
    </Style>
    <Style Selector="Button.glassArrow">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#66000000" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.glassArrow:pointerover">
      <Setter Property="Background" Value="#AA2E5C99" />
    </Style>
    <Style Selector="Button.glassArrow:pressed">
      <Setter Property="Background" Value="#CC2E5C99" />
    </Style>
    <Style Selector="Button.glassArrow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#CC2A2D31" />
      <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Border.filmItem">
      <Setter Property="Width" Value="200" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="#16181A" />
      <Setter Property="BorderBrush" Value="#2A2D30" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.filmItem.selected">
      <Setter Property="BorderBrush" Value="#5C99FF" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#225C99FF" />
    </Style>
    <Style Selector="TextBlock.emptyHint">
      <Setter Property="Foreground" Value="#B7BDC4" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.dropHighlight">
      <Setter Property="BorderBrush" Value="#4E84D4" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="Background" Value="#1F4E84D4" />
    </Style>
    <Style Selector="Border.loupe">
      <Setter Property="Background" Value="Black" />
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.bar">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#C9CDD2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hintToast">
      <Setter Property="Foreground" Value="#E8A33D" />
    </Style>
    <Style Selector="Border.infoPanel">
      <Setter Property="Width" Value="182" />
      <Setter Property="Background" Value="#C016181B" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,18,18,0" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="TextBlock.infoText">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="22" />
      <Setter Property="Foreground" Value="#D6DADF" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Background" Value="#24282C" />
    </Style>

    <!-- 暗色主题下 Menu/MenuItem 显式样式，防止 FluentTheme 继承链断了黑字黑底 -->
    <Style Selector="Menu > MenuItem">
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Menu > MenuItem:pointerover">
      <Setter Property="Background" Value="#2A2D31" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="Background" Value="#1F2124" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0" x:Name="TopMenu"
          Background="#1F2124" Foreground="#E5E7EB" Padding="8,4" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="8,4" x:Name="Toolbar"
                Background="#181A1D">
      <Button Classes="tool" x:Name="BtnOpenFolder" Content="打开文件夹" ToolTip.Tip="Ctrl+O 打开文件夹" />
      <Button Classes="tool" x:Name="BtnOpenImages" Content="打开图片" ToolTip.Tip="Ctrl+Shift+O 打开多张图片" />
      <Button Classes="tool" x:Name="BtnSort" Content="排序 ▾" ToolTip.Tip="切换排序方式" />
      <Button Classes="tool" x:Name="BtnCompare" Content="对比" ToolTip.Tip="左右分栏对比两张图片" />
      <ComboBox x:Name="ComparePicker" MinWidth="140" MaxWidth="200" IsVisible="False"
                FontSize="12" VerticalAlignment="Center" />
      <Button Classes="tool" x:Name="BtnInfo" Content="图片信息" ToolTip.Tip="I 显示/隐藏 EXIF 信息面板" />
      <Button Classes="tool" x:Name="BtnList" Content="隐藏列表" ToolTip.Tip="L 显示/隐藏胶片栏" />
      <Button Classes="tool" x:Name="BtnSlideshow" Content="幻灯片" ToolTip.Tip="开始/停止自动播放" />
      <Panel HorizontalAlignment="Right" Width="10" />
      <Button Classes="tool" x:Name="BtnFit" Content="适合窗口" HorizontalAlignment="Right" ToolTip.Tip="F 或 9" />
      <Button Classes="tool" x:Name="BtnActual" Content="实际大小" HorizontalAlignment="Right" ToolTip.Tip="0 或双击" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="232,Auto,1*">
      <local:Filmstrip x:Name="Strip" MinWidth="120" MaxWidth="480"
                       Grid.Column="0" VerticalAlignment="Stretch" />
      <GridSplitter Grid.Column="1" Width="5" Background="#24282C" HorizontalAlignment="Stretch" />

      <Grid Grid.Column="2" x:Name="MainSplit" ColumnDefinitions="1*,0,0">
        <!-- 主画布 -->
        <Panel Grid.Column="0">
          <local:ImageViewer x:Name="MainViewer" />
          <Button Classes="glassArrow" x:Name="BtnPrev" Content="‹"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" />
          <Button Classes="glassArrow" x:Name="BtnNext" Content="›"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
          <Border Classes="infoPanel" x:Name="InfoPanel" IsVisible="False"
                  HorizontalAlignment="Right" VerticalAlignment="Top">
            <ScrollViewer>
              <TextBlock Classes="infoText" x:Name="InfoText" />
            </ScrollViewer>
          </Border>
        </Panel>

        <!-- 对比区（进入对比模式时展开） -->
        <Border Grid.Column="1" Classes="divider" x:Name="CompareDivider" IsVisible="False" />
        <Grid Grid.Column="2" x:Name="CompareArea" IsVisible="False">
          <local:ImageViewer x:Name="CompareViewer" Margin="0,0,0,0" />
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#101214" Height="34">
      <Grid ColumnDefinitions="1*,Auto,1*">
        <TextBlock Grid.Column="0" Classes="bar" x:Name="NameLabel" Margin="12,0"
                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="bar" x:Name="HintLabel"
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="560" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="12,0" Spacing="14">
          <TextBlock Classes="bar" x:Name="IndexLabel" />
          <TextBlock Classes="bar" x:Name="ZoomLabel" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
